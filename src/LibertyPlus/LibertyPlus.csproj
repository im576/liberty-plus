<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>LibertyPlus</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\..\bin\</OutputPath>
    <FrameworkDirectory Condition="'$(FrameworkDirectory)' == ''">..\..\..\GTAIV-Reborn</FrameworkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="ScriptHookDotNet"><HintPath>$(ScriptHookDotNetReference)</HintPath><Private>False</Private></Reference>
    <Reference Include="Liberty.Sdk"><HintPath>$(FrameworkDirectory)\sdk\Liberty.Sdk\bin\Liberty.Sdk.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LibertyFramework.net"><HintPath>$(FrameworkDirectory)\src\LibertyFramework\bin\Release\LibertyFramework.net.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
